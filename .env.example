# Copy to .env and set real values. Never commit secrets.
DATABASE_URL=postgresql://orca:orca_dev_password@localhost:5432/orca_ai?schema=public
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# ORCA self-hosted model server (vLLM-compatible OpenAI-style HTTP protocol).
# Example for a GPU server running vLLM: http://GPU_SERVER_HOST:8000/v1
ORCA_MODEL_BASE_URL=
ORCA_MODEL_NAME=Qwen/Qwen3-8B
# Optional bearer token if your private model gateway requires authentication.
ORCA_MODEL_API_KEY=

API_PORT=4000
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000
CORS_ORIGIN=http://localhost:3000
